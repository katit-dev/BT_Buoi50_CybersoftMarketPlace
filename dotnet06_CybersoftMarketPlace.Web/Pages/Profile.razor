@page "/profile"
@using dotnet06_CybersoftMarketPlace.Application.DTOs

@layout HomePageMaster

@inject UserStateService _userStateService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@implements IDisposable


@* ===================== TRANG HỒ SƠ NGƯỜI DÙNG ===================== *@

<div class="row g-4">

    @* --------- CỘT TRÁI: THẺ NGƯỜI DÙNG + MENU --------- *@
    <div class="col-12 col-md-4 col-lg-3">

        <div class="card border-0 shadow-sm mb-3">

            <div class="card-body text-center p-4">

                <img src="@(_userStateService.CurrentUser?.AvatarUrl
                                                                                           ?? "https://placehold.co/120x120?text=Avatar")"
                     alt="Ảnh đại diện" class="rounded-circle border mb-3" width="120" height="120" />

                <h6 class="fw-semibold mb-1">
                    @_userStateService.CurrentUser?.FullName
                </h6>

                <p class="small text-secondary mb-3">
                    @_userStateService.CurrentUser?.Email
                </p>

                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="FocusAvatarInput">

                    <i class="fas fa-camera me-1"></i>
                    Đổi ảnh đại diện

                </button>

            </div>

        </div>


        <div class="list-group shadow-sm">

            <a href="#" class="list-group-item list-group-item-action active">

                <i class="fas fa-user me-2"></i>
                Hồ sơ của tôi

            </a>


            <a href="#" class="list-group-item list-group-item-action">

                <i class="fas fa-lock me-2"></i>
                Đổi mật khẩu

            </a>


            <a href="#" class="list-group-item list-group-item-action">

                <i class="fas fa-map-marker-alt me-2"></i>
                Địa chỉ giao hàng

            </a>


            <a href="#" class="list-group-item list-group-item-action">

                <i class="fas fa-box me-2"></i>
                Đơn mua

            </a>


            <a href="#" class="list-group-item list-group-item-action">

                <i class="fas fa-ticket-alt me-2"></i>
                Kho voucher

            </a>


            <button type="button" class="list-group-item list-group-item-action text-danger" @onclick="Logout">

                <i class="fas fa-sign-out-alt me-2"></i>

                Đăng xuất

            </button>

        </div>

    </div>


    @* --------- CỘT PHẢI: CHI TIẾT HỒ SƠ --------- *@
    <div class="col-12 col-md-8 col-lg-9">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <h5 class="mb-1">
                    Hồ sơ của tôi
                </h5>

                <p class="small text-secondary mb-0">
                    Quản lý thông tin hồ sơ để bảo mật tài khoản
                </p>

            </div>


            <div class="card-body p-4">

                @* Mã người dùng *@
                <div class="row mb-3 align-items-center">

                    <label class="col-12 col-sm-3 col-form-label text-sm-end text-secondary">
                        Mã người dùng
                    </label>

                    <div class="col-12 col-sm-9">

                        <span class="badge bg-light text-secondary border font-monospace">

                            @_userStateService.CurrentUser?.Id

                        </span>

                    </div>

                </div>


                @* Họ và tên *@
                <div class="row mb-3 align-items-center">

                    <label for="fullName" class="col-12 col-sm-3 col-form-label text-sm-end text-secondary">

                        Họ và tên

                    </label>


                    <div class="col-12 col-sm-9">

                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="fas fa-user text-secondary"></i>

                            </span>

                            <input type="text" class="form-control" id="fullName" @bind="updateProfileModel.FullName" />

                        </div>

                    </div>

                </div>


                @* Email - chỉ xem *@
                <div class="row mb-3 align-items-center">

                    <label for="email" class="col-12 col-sm-3 col-form-label text-sm-end text-secondary">

                        Email

                    </label>


                    <div class="col-12 col-sm-9">

                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="fas fa-envelope text-secondary"></i>

                            </span>

                            <input type="email" class="form-control" id="email"
                                   value="@_userStateService.CurrentUser?.Email" disabled />

                        </div>

                    </div>

                </div>


                @* Số điện thoại *@
                <div class="row mb-3 align-items-center">

                    <label for="phoneNumber" class="col-12 col-sm-3 col-form-label text-sm-end text-secondary">

                        Số điện thoại

                    </label>


                    <div class="col-12 col-sm-9">

                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="fas fa-phone text-secondary"></i>

                            </span>

                            <input type="tel" class="form-control" id="phoneNumber" @bind="updateProfileModel.Phone" />

                        </div>

                    </div>

                </div>


                @* Địa chỉ *@
                <div class="row mb-3">

                    <label for="address" class="col-12 col-sm-3 col-form-label text-sm-end text-secondary">

                        Địa chỉ

                    </label>


                    <div class="col-12 col-sm-9">

                        <div class="input-group">

                            <span class="input-group-text bg-white align-items-start">

                                <i class="fas fa-map-marker-alt text-secondary"></i>

                            </span>

                            <textarea class="form-control" id="address" rows="2" @bind="updateProfileModel.Address">
                            </textarea>

                        </div>

                    </div>

                </div>


                @* Ảnh đại diện *@
                <div class="row mb-4">

                    <label for="avatarUrl" class="col-12 col-sm-3 col-form-label text-sm-end text-secondary">

                        Ảnh đại diện

                    </label>


                    <div class="col-12 col-sm-9">

                        <div class="d-flex align-items-center gap-3">

                            <img src="@(_userStateService.CurrentUser?.AvatarUrl
                                                                                                                                           ?? "https://placehold.co/64x64?text=Avatar")"
                                 alt="Ảnh đại diện" class="rounded-circle border" width="64" height="64" />


                            <div class="flex-grow-1">

                                <div class="input-group">

                                    <span class="input-group-text bg-white">

                                        <i class="fas fa-image text-secondary"></i>

                                    </span>

                                    <input type="text" class="form-control" id="avatarUrl"
                                           @bind="updateAvatarModel.AvatarUrl" placeholder="Nhập đường dẫn ảnh đại diện" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                @* Thông báo *@
                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")" role="alert">

                        @message

                    </div>
                }


                @* Nút hành động *@
                <div class="row">

                    <div class="col-12 col-sm-9 offset-sm-3">

                        <button type="button" class="btn btn-danger px-4 me-2" @onclick="SaveChanges"
                                disabled="@isLoading">

                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status">
                                </span>

                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <i class="fas fa-save me-1"></i>
                                <span>Lưu thay đổi</span>
                            }

                        </button>


                        <button type="button" class="btn btn-outline-secondary px-4" @onclick="CancelChanges"
                                disabled="@isLoading">

                            Huỷ

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    private UpdateProfileDTO updateProfileModel = new();

    private UpdateAvatarDTO updateAvatarModel = new();


    private bool isLoading = false;

    private bool isSuccess = false;

    private string message = "";


    protected override async Task OnInitializedAsync()
    {
        _userStateService.OnChange += StateHasChanged;

        await _userStateService.GetProfileAsync();


        if (_userStateService.CurrentUser == null)
        {
            _userStateService.OnChange -= StateHasChanged;

            NavigationManager.NavigateTo("/login");

            return;
        }


        LoadCurrentUserToForm();
    }


    private void LoadCurrentUserToForm()
    {
        if (_userStateService.CurrentUser == null)
        {
            return;
        }


        updateProfileModel.FullName =
            _userStateService.CurrentUser.FullName;


        updateProfileModel.Phone =
            _userStateService.CurrentUser.PhoneNumber;


        updateProfileModel.Address =
            _userStateService.CurrentUser.Address;


        updateAvatarModel.AvatarUrl =
            _userStateService.CurrentUser.AvatarUrl ?? "";
    }


    private async Task SaveChanges()
    {
        try
        {
            isLoading = true;

            message = "";


            HTTPResponseData<ProfileUserDTO>? profileResponse =
                await _userStateService.UpdateProfileAsync(
                    updateProfileModel
                );


            if (profileResponse == null ||
                profileResponse.statusCode != 200)
            {
                isSuccess = false;

                message =
                    profileResponse?.Message
                    ?? "Cập nhật thông tin hồ sơ thất bại.";

                return;
            }


            HTTPResponseData<ProfileUserDTO>? avatarResponse =
                await _userStateService.UpdateAvatarAsync(
                    updateAvatarModel
                );


            if (avatarResponse == null ||
                avatarResponse.statusCode != 200)
            {
                isSuccess = false;

                message =
                    avatarResponse?.Message
                    ?? "Cập nhật ảnh đại diện thất bại.";

                return;
            }


            isSuccess = true;

            message = "Cập nhật thông tin hồ sơ thành công.";


            LoadCurrentUserToForm();
        }
        catch (Exception ex)
        {
            isSuccess = false;

            message = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private void CancelChanges()
    {
        LoadCurrentUserToForm();

        message = "";
    }


    private async Task FocusAvatarInput()
    {
        await JS.InvokeVoidAsync(
            "eval",
            "document.getElementById('avatarUrl')?.focus();"
        );
    }

    private async Task Logout()
    {
        await _userStateService.LogoutAsync();
    }

    public void Dispose()
    {
        _userStateService.OnChange -= StateHasChanged;
    }

}