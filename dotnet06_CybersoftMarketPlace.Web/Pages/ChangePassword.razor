@page "/profile/password"

@layout HomePageMaster

@using dotnet06_CybersoftMarketPlace.Application.DTOs

@inject UserStateService _userStateService


<div class="container mt-4">


    <div class="card shadow-sm">


        <div class="card-header">

            <h5 class="mb-0">
                Đổi mật khẩu
            </h5>

        </div>



        <div class="card-body">


            <div class="row mb-3">

                <label class="col-sm-4 col-form-label">
                    Mật khẩu hiện tại
                </label>


                <div class="col-sm-8">

                    <input type="password"
                           class="form-control"
                           @bind="model.OldPassword" />

                </div>

            </div>



            <div class="row mb-3">

                <label class="col-sm-4 col-form-label">
                    Mật khẩu mới
                </label>


                <div class="col-sm-8">

                    <input type="password"
                           class="form-control"
                           @bind="model.NewPassword" />

                </div>

            </div>



            <div class="row mb-3">

                <label class="col-sm-4 col-form-label">
                    Nhập lại mật khẩu mới
                </label>


                <div class="col-sm-8">

                    <input type="password"
                           class="form-control"
                           @bind="model.ConfirmPassword" />

                </div>

            </div>



            <div class="text-center">


                <button class="btn btn-danger px-4"
                        @onclick="SubmitChangePassword">

                    Xác nhận

                </button>


            </div>



            @if(!string.IsNullOrEmpty(message))
            {

                <div class="alert mt-3 
                    @(success 
                        ? "alert-success" 
                        : "alert-danger")">

                    @message

                </div>

            }


        </div>

    </div>


</div>



@code {


    private ChangePasswordDTO model =
        new ChangePasswordDTO();


    private string message = "";

    private bool success;



    private async Task SubmitChangePassword()
    {

        HTTPResponseData<string>? response =
            await _userStateService
            .ChangePasswordAsync(model);



        if(response == null)
        {

            message = "Có lỗi xảy ra";

            success = false;

            return;

        }



        message = response.Message;


        success =
            response.statusCode == 200;



        if(success)
        {
            model = new ChangePasswordDTO();
        }

    }

}